/*
	Author Jacob A. Psimos
*/

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/pinctrl/pinctrl-zynqmp.h>
#include <dt-bindings/power/xlnx-zynqmp-power.h>
#include <dt-bindings/reset/xlnx-zynqmp-resets.h>

/ {
	model = "ALINX AXU3EGB";
	compatible = "alinx,axu3egb", "xlnx,xczu3eg", "xlnx,zynqmp";
	
	/delete-node/ aliases ;
	
	aliases {
		ethernet0 = &gem2;
		ethernet1 = &gem3;
		i2c0 = &i2c1;
		serial0 = &uart0;
		serial1 = &uart1;
		serial2 = &dcc;
		serial3 = &rs485_axi_uart16550_0;
		serial4 = &rs485_axi_uart16550_1;
		spi0 = &qspi;
	};

	ddr4_0_memory: memory@400000000 {
		compatible = "xlnx,ddr4-2.2";
		xlnx,ip-name = "ddr4";
		device_type = "memory";
		memory_type = "memory";
		reg = <0x00000004 0x00000000 0x0 0x40000000>;
		status = "okay";
	};

	pwm-fan {
		compatible = "pwm-fan";
		pwms = <&ttc0 1 4000000 0>;
	};

	pwm-leds {
		compatible = "pwm-leds";
		
		pl-led {
			pwms = <&ttc0 0 2000000 0>;
			label = "pl-led";
			max-brightness = <255>;
		};
	};

	gpio-leds {
        compatible = "gpio-leds";

        ps-led {
            label = "ps-led";
            gpios = <&gpio 40 GPIO_ACTIVE_HIGH>;
            default-state = "off";
        };
    };
	
    gpio-keys {
		compatible = "gpio-keys";
		autorepeat;

		ps-key {
			label = "ps-key";
			gpios = <&gpio 26 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
			debounce-interval = <70>;
			wakeup-source;
		};

		pl-key {
			label = "pl-key";
			gpios = <&gpio 78 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_1>;
			debounce-interval = <70>;
		};
    };
};

&rtc {
	status = "okay";
};

&psu_ethernet_2_mdio {
	#address-cells = <1>;
	#size-cells = <0>;
	
	gem2_phy: ethernet-phy@1 {
		compatible = "ethernet-phy-id7949.937c", "ethernet-phy-ieee802.3-c22";
		reg = <1>;
		reset-gpios = <&gpio 81 GPIO_ACTIVE_LOW>;
		reset-assert-us = <10000>;
		reset-deassert-us = <30000>;
		max-speed = <1000>;
	};
};

&gmii_to_rgmii_0 {
	compatible = "xlnx,gmii-to-rgmii-1.0";
	reg = <8>;
	phy-handle = <&gem2_phy>;
};

&gem2 {
	status = "okay";
	phy-mode = "gmii";
	phy-handle = <&gem2_phy>;
	local-mac-address = [52 22 95 00 01 02];
};

&gem3 {
	status = "okay";
	phy-mode = "rgmii-id";
	phy-handle = <&gem3_phy>;
	local-mac-address = [52 22 95 00 01 01];
	
	psu_ethernet_3_mdio: mdio {
		#address-cells = <1>;
		#size-cells = <0>;
		
		gem3_phy: ethernet-phy@1 {
			compatible = "ethernet-phy-id7949.937c", "ethernet-phy-ieee802.3-c22";
			device_type = "ethernet-phy";
			reg = <1>;
			max-speed = <1000>;
		};
	};
};

&i2c1 {
	status = "okay";
	clock-frequency = <400000>;

	eeprom@50 {
		compatible = "atmel,24c04";
		reg = <0x50>;
		pagesize = <16>;
	};

	lm75@48 {
		compatible = "ti,tmp75", "national,lm75";
		reg = <0x48>;
	};
};

&qspi {
	status = "okay";
	
	spi-nor@0 {
		compatible = "micron,mt25qu256", "jedec,spi-nor";
		reg = <0>;
		spi-max-frequency = <50000000>;
		spi-tx-bus-width = <4>;
		spi-rx-bus-width = <4>;
		#address-cells = <1>;
		#size-cells = <1>;
		m25p,fast-read;
	};
};

&gpio {
    status = "okay";
};

&ttc0 {
	status = "okay";
	#pwm-cells = <3>;
};

&sdhci0 {
	status = "okay";
};

&sdhci1 {
	status = "okay";
	no-1-8-v;
};

&dwc3_0 {
	status = "okay";
	dr_mode = "host";
};
